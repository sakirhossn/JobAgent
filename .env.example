# Database Connection (Default: local SQLite; for Supabase/PostgreSQL set postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# AI Provider ("mock" or "gemini" or "openai")
AI_PROVIDER="mock"
GEMINI_API_KEY=""

# Application Settings
APP_NAME="JobPilot AI"
DEFAULT_APPLICATION_POLICY="APPROVAL_REQUIRED"
MAX_DAILY_APPLICATIONS=10

# Email Integration (Optional Mock / SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="careers@example.com"
SMTP_PASS=""
EMAIL_FROM="Sakir Hassain <sakir.hassain@example.com>"
